# Optional market data API keys (docker compose reads this file for
# variable interpolation when using docker-compose.prod.yml).
# The app also works without them, but price updates will be limited.
BRAPI_API_TOKEN=
COINGECKO_API_KEY=
TWELVE_DATA_API_KEY=

# Optional: extra browser origins allowed to call the API directly.
# Not needed when the frontend is served by the backend (same origin).
# CORS_ORIGINS=["https://example.com"]
